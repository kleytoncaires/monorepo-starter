# ===========================================
# MONOREPO STARTER - CONFIGURAÇÃO DE AMBIENTE
# ===========================================
# Copie este arquivo para .env e preencha os valores
# Todos os serviços (backend, frontend, banco) usam este único arquivo

# ===========================================
# BANCO DE DADOS
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monorepo_db
POSTGRES_PORT=6543

# String de conexão para o backend (atualize host/porta conforme necessário)
# Para dev local: localhost:6543
# Para Docker: postgres:5432
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/monorepo_db?schema=public

# ===========================================
# BACKEND
# ===========================================
NODE_ENV=development
BACKEND_PORT=9000

# Configuração JWT (MUDE O JWT_SECRET EM PRODUÇÃO!)
JWT_SECRET=mude-isso-para-uma-string-segura-em-producao
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# FRONTEND
# ===========================================
FRONTEND_PORT=4200
FRONTEND_URL=http://localhost:4200

# URL da API para o frontend
VITE_API_URL=http://localhost:9000

# ===========================================
# EMAIL (SMTP)
# ===========================================
# DESENVOLVIMENTO: Use Mailpit (incluso no docker-compose.dev.yml)
#   - Interface web: http://localhost:8025
#   - SMTP: localhost:1025 (sem autenticação)
#
# PRODUÇÃO: Use SendGrid, AWS SES, Mailgun, ou outro provedor SMTP
#
# Configuração para desenvolvimento (Mailpit):
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@seudominio.com

# Configuração para produção (exemplo com SendGrid):
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USER=apikey
# MAIL_PASS=sua-api-key-aqui
# MAIL_FROM=noreply@seudominio.com

# ===========================================
# OPCIONAL - CLOUDFLARE TURNSTILE (CAPTCHA)
# ===========================================
# Obtenha as chaves em: https://dash.cloudflare.com/turnstile
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
